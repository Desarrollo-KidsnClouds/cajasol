---
import "../styles/global.css";

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Kids&Clouds Dashboard",
  description = "Dashboard ejecutivo para el patrocinio Cajasol",
} = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth dark">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var stored = localStorage.getItem("knc-theme");
        if (stored === "light") {
          root.classList.remove("dark");
          root.style.colorScheme = "light";
        } else {
          root.classList.add("dark");
          root.style.colorScheme = "dark";
        }
      })();
    </script>
    <style is:inline>
      html.dark {
        color-scheme: dark;
      }
      html.dark body {
        background-color: #0b0b0b !important;
        color: #a8a8a8;
      }
      html:not(.dark) body {
        background-color: #f8fafc;
        color: #475569;
      }
      html:not(.dark) {
        color-scheme: light;
      }
    </style>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>

    <link rel="icon" href="/logo_web_nuevo.png" type="image/png" />
    <link rel="apple-touch-icon" href="/logo_web_nuevo.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700;800&family=Quicksand:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      @media print {
        .no-print,
        header,
        footer {
          display: none !important;
        }

        html,
        body {
          background: #ffffff !important;
          color: #111827 !important;
        }
      }
    </style>
  </head>
  

  <body class="bg-slate-50 text-slate-600 antialiased dark:bg-[#0b0b0b] dark:text-[#a8a8a8]">
    <slot />
  </body>
</html>
