---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import PresentationVisuals from "../components/PresentationVisuals.astro";
import Objectives from "../components/Objectives.astro";
import ConversionFunnel from "../components/ConversionFunnel.astro";
import ImpactSpotlight from "../components/ImpactSpotlight.astro";
import Map from "../components/Map.astro";
import Testimonials from "../components/Testimonials.astro";
import AlliesEcosystem from "../components/AlliesEcosystem.astro";
import Sponsors from "../components/Sponsors.astro";
import Footer from "../components/Footer.astro";
import AppScripts from "../components/AppScripts.astro";
import PdfDownload from "../components/PdfDownload.astro";
---

<Layout
  title="Kids&Clouds para Cajasol | Dashboard"
  description="Dashboard ejecutivo de seguimiento territorial para el proyecto Kids&Clouds."
>
  <Header />
  <main class="dashboard-compact relative min-h-screen overflow-x-hidden bg-slate-50 text-base leading-relaxed text-slate-600 dark:bg-[#0b0b0b] dark:text-[#a8a8a8]">
    <div class="pointer-events-none fixed inset-0 -z-10 hidden dark:block bg-[radial-gradient(ellipse_at_50%_0%,rgba(212,175,55,0.05),transparent_60%)]"></div>
    <div
      class="pointer-events-none fixed inset-0 -z-10 hidden dark:block opacity-[0.03]"
      style="background-image: linear-gradient(rgba(212,175,55,0.4) 1px, transparent 1px), linear-gradient(90deg, rgba(212,175,55,0.4) 1px, transparent 1px); background-size: 64px 64px;"
    ></div>
    <div class="pointer-events-none fixed inset-0 -z-10 dark:hidden bg-[radial-gradient(ellipse_at_15%_0%,rgba(59,130,246,0.1),transparent_55%),radial-gradient(ellipse_at_85%_15%,rgba(139,92,246,0.07),transparent_50%)]"></div>
    <Hero />
    <PresentationVisuals />
    {/* <Objectives /> */}
    <ConversionFunnel />
    <ImpactSpotlight />
    <Map />
    <AlliesEcosystem />
    <Testimonials />
    {/* <Sponsors /> */}
    <Footer />
    <PdfDownload />

    <div
      id="video-modal"
      class="fixed inset-0 z-[61] flex hidden items-center justify-center bg-slate-900/90 p-4 opacity-0 backdrop-blur-lg transition-all duration-300 dark:bg-slate-950/95"
      role="dialog"
      aria-modal="true"
      aria-label="Reproducción de vídeo"
    >
      <button
        id="close-video-modal"
        type="button"
        class="absolute right-6 top-6 z-10 rounded-full border border-slate-800 bg-slate-900/50 p-3 font-mono text-2xl font-bold text-slate-400 transition-colors hover:border-[#f0b552]/40 hover:text-[#f0b552]"
        aria-label="Cerrar vídeo"
      >
        ✕
      </button>
      <div class="w-full max-w-4xl">
        <video
          id="modal-video"
          class="max-h-[85vh] w-full rounded-xl border border-slate-200 bg-black shadow-2xl dark:border-slate-700"
          controls
          playsinline
          preload="metadata"
        ></video>
        <p id="video-modal-error" class="mt-3 hidden text-center text-sm text-slate-300">
          No se pudo cargar el vídeo. Comprueba que el archivo <code class="text-amber-300">public/video_acuerdo.mp4</code> existe.
        </p>
      </div>
    </div>

    <dialog id="image-lightbox" class="image-lightbox" aria-label="Vista ampliada de imagen" tabindex="-1">
      <div class="image-lightbox__body">
        <button
          id="close-image-lightbox"
          type="button"
          class="image-lightbox__close"
          aria-label="Cerrar imagen"
        >
          ✕
        </button>
        <div class="image-lightbox__content">
          <div id="image-lightbox-frame" class="image-lightbox__frame">
            <img id="image-lightbox-img" alt="" />
          </div>
        </div>
      </div>
    </dialog>

    <script is:inline>
      (function () {
        const videoModal = document.getElementById("video-modal");
        const modalVideo = document.getElementById("modal-video");
        const closeVideoBtn = document.getElementById("close-video-modal");
        const videoError = document.getElementById("video-modal-error");
        if (videoModal && modalVideo) {
          const openVideoModal = (src) => {
            videoError?.classList.add("hidden");
            modalVideo.classList.remove("hidden");
            modalVideo.src = src;
            modalVideo.currentTime = 0;
            videoModal.classList.remove("hidden");
            videoModal.classList.remove("opacity-100");
            videoModal.classList.add("opacity-0");
            document.body.style.overflow = "hidden";
            requestAnimationFrame(() => {
              setTimeout(() => {
                videoModal.classList.remove("opacity-0");
                videoModal.classList.add("opacity-100");
                modalVideo.play().catch(() => {
                  videoError?.classList.remove("hidden");
                });
              }, 10);
            });
          };

          const closeVideoModal = () => {
            videoModal.classList.remove("opacity-100");
            videoModal.classList.add("opacity-0");
            modalVideo.pause();
            document.body.style.overflow = "";
            setTimeout(() => {
              videoModal.classList.add("hidden");
              modalVideo.removeAttribute("src");
              modalVideo.load();
            }, 300);
          };

          modalVideo.addEventListener("error", () => {
            modalVideo.classList.add("hidden");
            videoError?.classList.remove("hidden");
          });

          document.querySelectorAll(".video-play-trigger").forEach((trigger) => {
            const src = trigger.getAttribute("data-video-src");
            if (!src) return;
            trigger.addEventListener("click", () => openVideoModal(src));
            trigger.addEventListener("keydown", (e) => {
              if (e.key === "Enter" || e.key === " ") {
                e.preventDefault();
                openVideoModal(src);
              }
            });
          });

          closeVideoBtn?.addEventListener("click", closeVideoModal);
          videoModal.addEventListener("click", (e) => {
            if (e.target === videoModal) closeVideoModal();
          });
          document.addEventListener("keydown", (e) => {
            if (e.key === "Escape" && !videoModal.classList.contains("hidden")) closeVideoModal();
          });
        }
      })();
    </script>

    <AppScripts />
  </main>
</Layout>
