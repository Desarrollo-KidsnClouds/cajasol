---
const photo = {
  src: "/niño_leticia.jpg",
  alt: "Niño nadador mirando a cámara tras la competición",
};

const bodyText =
  "La conciliación laboral y familiar no es solo una necesidad: es poder estar presentes en lo importante. La mejor educación nace cuando profesorado, familia y alumnado forman un triángulo unido, conectado por una comunicación cercana y constante. Con esta acción, Fundación Cajasol acerca esa oportunidad a más familias andaluzas.";
---

<section id="impacto" class="impact-section mx-auto w-full max-w-6xl px-5" aria-label="Impacto en familias y alumnos">
  <div class="impact-block">
    <div class="impact-block__photo img-reveal-left img-reveal-hover" data-reveal-delay="0ms">
      <button
        type="button"
        class="gallery-card impact-block__btn group cursor-zoom-in border-0 bg-transparent p-0"
        aria-label="Ampliar imagen"
      >
        <img
          src={photo.src}
          alt={photo.alt}
          data-zoom-src={photo.src}
          class="impact-block__img"
          loading="lazy"
          decoding="async"
        />
      </button>
    </div>

    <blockquote class="impact-block__quote panel-glass img-reveal-right" data-reveal-delay="120ms">
      <header class="impact-block__header">
        <h2 class="impact-block__title">Igualdad de oportunidades</h2>
      </header>
      <p class="impact-block__text">{bodyText}</p>
    </blockquote>
  </div>
</section>

<style>
  .impact-block {
    display: grid;
    gap: 1rem;
    align-items: center;
    max-width: 54rem;
    margin-inline: auto;
  }

  @media (min-width: 640px) {
    .impact-block {
      grid-template-columns: 18rem 1fr;
      gap: 1.75rem;
    }
  }

  .impact-block__photo {
    width: 100%;
    max-width: 18rem;
    margin-inline: auto;
    overflow: hidden;
    border-radius: 0.75rem;
  }

  @media (min-width: 640px) {
    .impact-block__photo {
      margin-inline: 0;
    }
  }

  .impact-block__btn {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    cursor: zoom-in;
  }

  .impact-block__btn:hover .impact-block__img {
    opacity: 0.92;
  }

  .impact-block__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 28%;
    transition: opacity 0.25s ease;
  }

  .impact-block__quote {
    margin: 0;
    padding: 1.15rem 1.25rem;
    border-radius: 0.85rem;
    border-left: 3px solid #f0b552;
  }

  .impact-block__header {
    margin-bottom: 0.75rem;
  }

  .impact-block__title {
    margin: 0;
    font-family: "Poppins", sans-serif;
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.3;
    color: #0f172a;
  }

  html.dark .impact-block__title {
    color: #ffffff;
  }

  .impact-block__text {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: #475569;
  }

  html.dark .impact-block__text {
    color: #cbd5e1;
  }

  @media (min-width: 640px) {
    .impact-block__title {
      font-size: 1.125rem;
    }
  }
</style>
