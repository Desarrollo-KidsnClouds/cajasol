            <p class="text-[11px] leading-tight text-slate-400">Centros firmados</p>
          </div>
          <div class="card-fx rounded-xl border border-indigo-400/40 bg-gradient-to-br from-indigo-50 to-violet-100/50 p-3 shadow-sm shadow-indigo-500/10 dark:border-indigo-500/30 dark:from-indigo-500/10 dark:to-transparent">
