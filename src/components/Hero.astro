<section id="inicio" class="section-no-gap section-glow relative overflow-hidden border-b border-slate-100 dark:border-[rgba(212,175,55,0.1)]">
  <div class="pointer-events-none absolute -left-32 top-0 h-72 w-72 animate-float-soft rounded-full bg-[#D4AF37]/5 blur-3xl"></div>
  <div class="pointer-events-none absolute bottom-0 left-1/2 h-48 w-[600px] -translate-x-1/2 bg-[radial-gradient(ellipse_at_center,_rgba(212,175,55,0.06),_transparent_70%)]"></div>

  <div class="relative mx-auto grid w-full max-w-6xl items-center gap-6 px-6 py-8 lg:grid-cols-[1fr_1fr] lg:py-10">
    <div class="reveal-left flex flex-col items-center text-center lg:items-center lg:text-center">
      <div class="flex flex-wrap items-center justify-center gap-2">
        <span class="badge-glow px-4 py-1.5 text-sm font-bold">
          Patrocinio 50.000€
        </span>
        <span class="inline-flex rounded-full border border-[rgba(212,175,55,0.25)] bg-[rgba(212,175,55,0.06)] px-4 py-1.5 text-sm font-semibold text-slate-600 dark:text-[#a8a8a8]">
          Alianza Cajasol × Kids&Clouds
        </span>
      </div>

      <h1
        class="mt-4 font-extrabold leading-[1.08] tracking-tight text-[#f0b552] dark:text-[#f0b552]"
        style="font-family: 'Poppins';"
      >
        Alianza estratégica por la innovación educativa en Andalucía
      </h1>

      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-slate-500 dark:text-[#a8a8a8]">
        La alianza nace con el objetivo de impulsar la transformación digital del sector educativo andaluz y facilitar la
        conciliación de la vida laboral y familiar de las familias.
      </p>
      <p class="mt-3 mx-auto max-w-2xl text-lg leading-relaxed text-slate-500 dark:text-[#a8a8a8]">
        A través de este acuerdo, Fundación Cajasol financia el acceso a la plataforma Kids&Clouds para 70 centros
        educativos andaluces, permitiendo que 3.500 familias puedan beneficiarse de una herramienta segura, sencilla y
        eficaz para mejorar la comunicación diaria con sus centros.
      </p>

      <div class="mt-7 flex flex-wrap items-center justify-center gap-3">
        <button
          type="button"
          data-download-pdf
          class="btn-fx btn-gradient no-print inline-flex items-center gap-2 rounded-xl px-5 py-2.5 text-sm font-semibold"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition group-hover:translate-y-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          Descargar Nota de Prensa
        </button>
        <a
          href="#presentacion"
          class="card-fx panel-glass inline-flex rounded-xl px-5 py-2.5 text-sm font-semibold text-[#D4AF37] hover:!scale-[1.02]"
        >
          Ver presentación
        </a>
      </div>
    </div>

    <div class="reveal-right shine-border relative mx-auto w-full max-w-sm" data-reveal-delay="120ms">
      <div class="absolute -inset-1 animate-pulse-glow rounded-2xl bg-gradient-to-br from-[#f0b552]/25 via-[#f0b552]/10 to-transparent blur-sm"></div>
      <div class="panel-glass relative rounded-2xl p-4 transition duration-500">
        <!-- Título amarillo y negro -->
        <div class="mb-3 flex items-center justify-center gap-2 rounded-md border border-[#D4AF37]/60 bg-[#D4AF37]/10 px-3 py-1.5">
          <span class="text-xs font-extrabold uppercase tracking-[0.15em] text-[#b8942e] dark:text-[#D4AF37]">Objetivo</span>
          <span class="text-xs text-slate-400">vs</span>
          <span class="text-xs font-extrabold uppercase tracking-[0.15em] text-[#b8942e] dark:text-[#D4AF37]">Avance Actual</span>
        </div>
        <div class="grid grid-cols-2 gap-2.5">
          <div class="card-fx group rounded-lg border border-slate-200 bg-white p-4 dark:border-[rgba(212,175,55,0.12)] dark:bg-[rgba(255,255,255,0.02)]">
            <p class="text-3xl font-extrabold tabular-nums text-slate-900 transition group-hover:text-[#D4AF37] dark:text-white" style="font-family:'Poppins'">70</p>
            <p class="mt-1.5 text-sm leading-snug text-slate-500 dark:text-[#6b6b6b]">Centros educativos a incorporar</p>
          </div>
          <div class="card-fx group rounded-lg border border-slate-200 bg-white p-4 dark:border-[rgba(212,175,55,0.12)] dark:bg-[rgba(255,255,255,0.02)]">
            <p class="text-3xl font-extrabold tabular-nums text-slate-900 transition group-hover:text-[#D4AF37] dark:text-white" style="font-family:'Poppins'">3.500</p>
            <p class="mt-1.5 text-sm leading-snug text-slate-500 dark:text-[#6b6b6b]">Familias a beneficiar</p>
          </div>
          <div class="card-fx group rounded-lg border border-[#D4AF37]/30 bg-[#D4AF37]/5 p-4">
            <p class="text-3xl font-extrabold tabular-nums text-[#D4AF37] transition group-hover:scale-105" style="font-family:'Poppins'">16</p>
            <p class="mt-1.5 text-sm leading-snug text-slate-500 dark:text-[#6b6b6b]">Centros incorporados</p>
          </div>
          <div class="card-fx group rounded-lg border border-[#D4AF37]/30 bg-[#D4AF37]/5 p-4">
            <p class="text-3xl font-extrabold tabular-nums text-[#D4AF37] transition group-hover:scale-105" style="font-family:'Poppins'">823</p>
            <p class="mt-1.5 text-sm leading-snug text-slate-500 dark:text-[#6b6b6b]">Familias beneficiadas</p>
          </div>
        </div>
        <div class="mt-2.5 flex items-center justify-center rounded-lg border border-slate-200 bg-slate-50/50 px-3 py-2 text-xs dark:border-[rgba(212,175,55,0.12)] dark:bg-transparent">
          <span class="font-medium text-slate-500 dark:text-[#6b6b6b]">Cobertura de Andalucía</span>
        </div>
      </div>
    </div>
  </div>
</section>
