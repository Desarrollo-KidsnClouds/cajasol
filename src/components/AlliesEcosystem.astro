---
const stats = [
  { value: "140", label: "Centros asociados" },
  { value: "40.000", label: "Alumnos" },
  { value: "1.800", label: "Docentes" },
];

const executedActions = [
  "Email anunciando el acuerdo a todos los asociados",
  "Mención en canal WhatsApp-ACES",
  "Aparición en Boletín Semanal nº160",
];
---

<section
  id="ecosistema-aliados"
  class="mx-auto w-full max-w-6xl px-5"
  aria-label="Ecosistema de aliados — ACES Andalucía"
>
  <header class="reveal mb-3">
    <p class="section-eyebrow section-eyebrow--amber">Alianza con ACES Andalucía</p>
    <h2 class="section-title mt-2">Ecosistema de aliados</h2>
    <p class="mt-2 max-w-2xl text-sm text-slate-600 dark:text-slate-400">
      Red de centros educativos asociados que amplifica el alcance del convenio Cajasol × Kids&Clouds en Andalucía.
    </p>
  </header>

  <div class="grid gap-4 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)]">
    <article
      class="reveal card-fx shine-border panel-glass group flex flex-col justify-between overflow-hidden p-5 sm:p-6"
      data-reveal-delay="0ms"
    >
      <div class="flex flex-wrap items-start gap-4">
        <div
          class="flex h-16 w-16 shrink-0 items-center justify-center rounded-2xl border border-indigo-500/30 bg-gradient-to-br from-indigo-600/20 via-blue-600/15 to-amber-500/10 shadow-inner shadow-indigo-500/10 transition duration-300 group-hover:scale-105 group-hover:border-indigo-400/50 dark:from-indigo-500/25 dark:to-amber-500/15"
          aria-hidden="true"
        >
          <span class="text-lg font-extrabold tracking-tight text-indigo-700 dark:text-indigo-200">ACES</span>
        </div>
        <div class="min-w-0 flex-1">
          <p class="text-xs font-semibold uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400">
            Aliado destacado
          </p>
          <h3 class="mt-1 text-xl font-bold text-slate-900 sm:text-2xl dark:text-white">ACES Andalucía</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
            Asociación de centros educativos privados que conecta la iniciativa con una red consolidada de centros,
            familias y docentes en la comunidad autónoma.
          </p>
        </div>
      </div>

      <div class="mt-5 border-t border-slate-200/80 pt-4 dark:border-slate-700/60">
        <h4 class="text-xs font-bold uppercase tracking-wide text-slate-700 dark:text-slate-200">
          Acciones ya ejecutadas
        </h4>
        <ul class="mt-3 space-y-2" role="list">
          {
            executedActions.map((action) => (
              <li class="flex items-start gap-2.5 rounded-lg border border-slate-200/80 bg-slate-50/60 px-2.5 py-2 transition duration-300 hover:border-emerald-500/30 hover:bg-emerald-500/5 dark:border-slate-700/60 dark:bg-slate-800/40 dark:hover:border-emerald-500/25 dark:hover:bg-emerald-500/10">
                <span
                  class="mt-0.5 inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full border border-emerald-500/35 bg-emerald-500/15 text-xs font-bold text-emerald-700 dark:text-emerald-300"
                  aria-hidden="true"
                >
                  ✓
                </span>
                <span class="text-xs leading-relaxed text-slate-700 sm:text-sm dark:text-slate-200">{action}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <span class="badge-glow badge-glow--indigo mt-4 w-fit">Alianza activa · Comunicación en curso</span>
    </article>

    <div class="grid gap-3 sm:grid-cols-3 lg:grid-cols-1" data-scroll-stagger>
      {
        stats.map((stat, index) => (
          <article
            class="reveal stat-card card-fx shine-border panel-glass group p-4 text-center"
            data-reveal-delay={`${(index + 1) * 80}ms`}
          >
            <p class="objective-number text-[2.25rem] font-extrabold tracking-tight transition duration-300 group-hover:scale-105 sm:text-[2.5rem]">
              {stat.value}
            </p>
            <p class="mt-2 text-sm text-slate-600 transition duration-300 group-hover:text-slate-900 dark:text-slate-300 dark:group-hover:text-slate-200">
              {stat.label}
            </p>
          </article>
        ))
      }
    </div>
  </div>

  <div class="reveal pointer-events-auto mt-4" data-reveal-delay="80ms">
    <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400">
          Red territorial
        </p>
        <p class="mt-0.5 text-sm font-bold text-slate-800 dark:text-slate-100">Mapa de centros asociados ACES</p>
      </div>
      <span class="badge-glow badge-glow--amber shrink-0">Andalucía</span>
    </div>

    <img
      src="/MAPA-ACES-3.png"
      alt="Mapa de la red de centros asociados ACES en Andalucía"
      width={686}
      height={409}
      class="gallery-card gallery-card-fx aces-map-img pointer-events-auto mx-auto block h-auto w-full max-w-[686px] cursor-zoom-in rounded-xl opacity-95 transition-all duration-300 hover:opacity-100"
      role="button"
      tabindex="0"
      aria-label="Ver mapa ACES Andalucía a tamaño completo"
      loading="eager"
      decoding="async"
    />
  </div>
</section>

<style>
  .aces-map-img {
    image-rendering: auto;
  }
</style>
