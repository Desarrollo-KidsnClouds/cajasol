---
const stats = [
  { value: "140", label: "Centros asociados" },
  { value: "40.000", label: "Alumnos" },
  { value: "1.800", label: "Docentes" },
];

const executedActions = [
  "Email anunciando el acuerdo a todos los asociados",
  "Mención en canal WhatsApp-ACES",
  "Aparición en Boletín Semanal nº160",
  "Llamada a los 140 centros",
];
---

<section
  id="repercusion"
  class="mx-auto w-full max-w-6xl px-5"
  aria-label="Ecosistema de aliados — ACES Andalucía"
>
  <header class="allies-section__header reveal">
    <p class="section-eyebrow section-eyebrow--amber">Convenios de colaboración</p>
  </header>

  <div class="grid gap-3 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)]">
    <article
      class="reveal card-fx shine-border panel-glass group flex flex-col justify-between overflow-hidden p-4"
      data-reveal-delay="0ms"
    >
      <div class="flex items-start justify-between gap-3">
        <div class="min-w-0 flex-1">
          <h3 class="text-base font-bold text-slate-900 dark:text-white">ACES Andalucía</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
            Kids&Clouds firma un acuerdo con ACES Andalucia para divulgar el apoyo de Fundación Cajasol al sector educativo y a las familias andaluzas.
          </p>
          <p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
            ACES agrupa a más de 140 centros educativos en las 8 provincias andaluzas, representando a más de 40.000 alumnos y 1.800 docentes.
          </p>
        </div>
        <div
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-indigo-500/30 bg-gradient-to-br from-indigo-600/20 via-blue-600/15 to-amber-500/10 transition duration-300 group-hover:scale-105 group-hover:border-indigo-400/50 dark:from-indigo-500/25 dark:to-amber-500/15"
          aria-hidden="true"
        >
          <span class="text-xs font-extrabold tracking-tight text-indigo-700 dark:text-indigo-200">ACES</span>
        </div>
      </div>

      <div class="mt-3 border-t border-slate-200/80 pt-3 dark:border-slate-700/60">
        <h4 class="text-sm font-bold uppercase tracking-wide text-slate-700 dark:text-slate-200">
          Acciones ya realizadas
        </h4>
        <ul class="mt-2 space-y-1.5" role="list">
          {executedActions.map((action) => (
            <li class="flex items-start gap-2.5 rounded-md border border-slate-200/80 bg-slate-50/60 px-2.5 py-2 transition duration-300 hover:border-emerald-500/30 hover:bg-emerald-500/5 dark:border-slate-700/60 dark:bg-slate-800/40 dark:hover:border-emerald-500/25 dark:hover:bg-emerald-500/10">
              <span class="mt-0.5 inline-flex h-[1.125rem] w-[1.125rem] shrink-0 items-center justify-center rounded-full border border-emerald-500/35 bg-emerald-500/15 text-[11px] font-bold text-emerald-700 dark:text-emerald-300" aria-hidden="true">✓</span>
              <span class="text-sm leading-snug text-slate-700 dark:text-slate-200">{action}</span>
            </li>
          ))}
        </ul>
      </div>

      <span class="badge-glow badge-glow--indigo mt-3 w-fit">Alianza activa · Comunicación en curso</span>
    </article>

    <!-- Stats rediseñadas -->
    <div class="grid gap-2 sm:grid-cols-3 lg:grid-cols-1" data-scroll-stagger>
      {stats.map((stat, index) => (
        <article
          class="reveal card-fx shine-border panel-glass group flex items-center gap-4 p-4"
          data-reveal-delay={`${(index + 1) * 80}ms`}
        >
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-[rgba(240,181,82,0.1)] border border-[rgba(240,181,82,0.2)]">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#f0b552" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              {index === 0 && <><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></>}
              {index === 1 && <><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></>}
              {index === 2 && <><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></>}
            </svg>
          </div>
          <div>
            <p class="text-[11px] font-semibold uppercase tracking-widest text-slate-400 dark:text-slate-500">{stat.label}</p>
            <p class="mt-0.5 font-extrabold text-[#f0b552] transition duration-300 group-hover:scale-105" style="font-family:'Poppins'; font-size:1.4rem; line-height:1;">{stat.value}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  #repercusion .allies-section__header {
    margin-bottom: 1.5rem !important;
  }

  @media (min-width: 640px) {
    #repercusion .allies-section__header {
      margin-bottom: 1.75rem !important;
    }
  }
</style>
