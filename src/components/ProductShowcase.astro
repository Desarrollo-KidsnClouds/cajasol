---
const productImages = [
  {
    lightSrc: "/imagen1_claro.png",
    darkSrc: "/imagen1_oscuro.png",
    alt: "Comunicación con familias desde el centro educativo",
    ariaLabel: "Ampliar captura de comunicación con familias",
    reveal: "reveal-left",
    delay: "0ms",
  },
  {
    lightSrc: "/imagen2_claro.png",
    darkSrc: "/imagen2_oscuro.png",
    alt: "Experiencia de uso en el aula",
    ariaLabel: "Ampliar captura de experiencia de aula",
    reveal: "reveal-right",
    delay: "80ms",
  },
];
---

<section id="producto" class="mx-auto w-full max-w-6xl px-5" aria-label="Producto Kids&Clouds">
  <header class="reveal mb-3">
    <p class="section-eyebrow section-eyebrow--amber">Producto</p>
    <h2 class="section-title mt-2">La plataforma en acción</h2>
    <p class="mt-2 max-w-3xl text-base text-slate-600 dark:text-slate-300">
      Capturas reales de nuestro producto Kids&Clouds.
    </p>
  </header>

  <div class="product-grid grid grid-cols-1 gap-3 sm:grid-cols-2 sm:gap-4" data-scroll-stagger>
    {
      productImages.map((item) => (
        <article
          class={`product-card ${item.reveal} card-fx shine-border panel-glass`}
          data-reveal-delay={item.delay}
        >
          <div class="px-3 pt-3 sm:px-4 sm:pt-4">
            <span class="badge-glow badge-glow--amber" style="margin:0;">Producto</span>
          </div>
          <div class="product-card__media">
            <button
              type="button"
              class="gallery-card product-visual group h-full w-full cursor-zoom-in border-0 bg-transparent p-0"
              aria-label={item.ariaLabel}
            >
              <img
                src={item.lightSrc}
                alt={item.alt}
                data-zoom-src={item.lightSrc}
                class="product-visual__img theme-img theme-img--light"
                loading="lazy"
                decoding="async"
              />
              <img
                src={item.darkSrc}
                alt={item.alt}
                data-zoom-src={item.darkSrc}
                class="product-visual__img theme-img theme-img--dark"
                loading="lazy"
                decoding="async"
              />
              <span class="product-zoom-hint" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="11" cy="11" r="7"></circle>
                  <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                  <line x1="11" y1="8" x2="11" y2="14"></line>
                  <line x1="8" y1="11" x2="14" y2="11"></line>
                </svg>
              </span>
            </button>
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .product-grid {
    align-items: stretch;
    width: 95%;
    max-width: 95%;
    margin-inline: auto;
  }

  .product-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .product-card__media {
    flex: 1 1 auto;
    margin: 0.5rem 0.75rem 0.75rem;
    overflow: visible;
    border-radius: 0.75rem;
    background: rgba(248, 250, 252, 0.6);
    border: 1px solid rgba(148, 163, 184, 0.15);
  }

  @media (min-width: 640px) {
    .product-card__media {
      margin: 0.5rem 1rem 1rem;
    }
  }

  html.dark .product-card__media {
    background: rgba(15, 23, 42, 0.45);
    border-color: rgba(148, 163, 184, 0.12);
  }

  .product-visual {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    width: 100%;
    margin: 0;
    padding: 0;
    border: none;
    background: transparent;
    box-shadow: none;
    overflow: hidden;
    border-radius: 0.75rem;
  }

  .product-visual__img {
    display: block;
    width: 100%;
    height: auto;
    max-height: none;
    object-fit: contain;
    object-position: center center;
    transition: opacity 0.3s ease;
  }

  .theme-img--dark {
    display: none;
  }

  html.dark .theme-img--light {
    display: none;
  }

  html.dark .theme-img--dark {
    display: block;
  }

  .product-visual:hover .product-visual__img {
    opacity: 0.88;
  }

  .product-zoom-hint {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(15, 23, 42, 0.42);
    opacity: 0;
    transition: opacity 0.25s ease;
    pointer-events: none;
  }

  .product-zoom-hint svg {
    width: 2.25rem;
    height: 2.25rem;
    padding: 0.55rem;
    border-radius: 9999px;
    color: #0f172a;
    background: rgba(255, 255, 255, 0.95);
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.28);
  }

  html.dark .product-zoom-hint {
    background: rgba(0, 0, 0, 0.48);
  }

  html.dark .product-zoom-hint svg {
    color: #f0b552;
    background: rgba(15, 23, 42, 0.92);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
  }

  .product-visual:hover .product-zoom-hint,
  .product-visual:focus-visible .product-zoom-hint {
    opacity: 1;
  }
</style>
