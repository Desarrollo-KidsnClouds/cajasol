---
import { navLinks } from "../data/navigation";
---

<header
  class="site-header no-print relative z-50 mx-auto w-[calc(100%-2rem)] max-w-5xl py-3 transition-all duration-300 sm:fixed sm:inset-x-0 sm:top-0 sm:w-[calc(100%-4rem)] sm:max-w-5xl sm:py-2"
>
  <div class="site-header-inner header-layout w-full overflow-visible rounded-2xl border border-slate-200/80 bg-white/90 px-3 py-1.5 shadow-[0_4px_16px_rgba(15,23,42,0.08)] backdrop-blur-xl dark:border-[rgba(212,175,55,0.15)] dark:bg-[#0f0f0f]/90 dark:shadow-[0_4px_24px_rgba(0,0,0,0.5)] sm:px-5 sm:py-1.5 lg:px-6">
    <a
      href="#inicio"
      class="header-logos-link header-layout__logos group flex shrink-0 items-center"
      aria-label="Kids&Clouds y Fundación Cajasol — Inicio"
    >
      <div class="header-logos flex shrink-0 items-center gap-2 sm:gap-2.5" aria-label="Kids&Clouds y Fundación Cajasol">
        <span class="header-logo-wrap header-logo-wrap--knc">
          <img
            src="/logo_web_nuevo.png"
            alt="Logo Kids&Clouds"
            width="320"
            height="104"
            class="header-logo header-logo--knc"
            loading="eager"
            decoding="async"
          />
        </span>
        <span class="header-logo-wrap header-logo-wrap--cajasol">
          <img
            src="/Logo_Fundación_Cajasol.png"
            alt="Logo Fundación Cajasol"
            width="240"
            height="84"
            class="header-logo header-logo--cajasol"
            loading="eager"
            decoding="async"
          />
        </span>
      </div>
    </a>

    <nav
      id="mainNav"
      class="header-nav-scroll header-layout__nav hidden min-w-0 border-l border-slate-200/70 pl-3 dark:border-[rgba(212,175,55,0.1)] sm:block md:pl-4"
      aria-label="Navegación principal"
    >
      <ul class="header-nav-list flex items-center gap-2.5 pr-1 sm:gap-3 md:gap-4">
        {
          navLinks.map((link) => (
            <li class="shrink-0">
              <a
                href={link.href}
                data-nav-link
                class="header-nav-link whitespace-nowrap rounded-md px-2 py-1 font-medium text-slate-500 transition-colors hover:text-slate-900 dark:text-[#6b6b6b] dark:hover:text-white"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <button
      id="themeToggle"
      type="button"
      class="theme-toggle header-layout__theme inline-flex h-8 w-8 shrink-0 items-center justify-center self-center rounded-lg border border-[rgba(212,175,55,0.2)] bg-transparent text-[#6b6b6b] transition hover:border-[#D4AF37]/50 hover:text-[#D4AF37] sm:h-9 sm:w-9"
      aria-label="Activar modo oscuro"
      aria-pressed="false"
      title="Modo oscuro"
    >
      <svg class="icon-sun h-[1rem] w-[1rem]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
      </svg>
      <svg class="icon-moon h-[1rem] w-[1rem]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
      </svg>
    </button>
  </div>
</header>

<div class="site-header-spacer no-print hidden sm:block" aria-hidden="true"></div>

<style>
  @media (min-width: 640px) {
    .site-header {
      top: env(safe-area-inset-top, 0);
    }
  }

  .site-header-spacer {
    height: calc(5rem + env(safe-area-inset-top, 0px));
  }

  @media (min-width: 1024px) {
    .site-header-spacer {
      height: calc(5.5rem + env(safe-area-inset-top, 0px));
    }
  }

  .header-layout {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas: "logos theme";
    gap: 0 0.75rem;
    align-items: center;
  }

  .header-layout__logos {
    grid-area: logos;
    justify-self: center;
  }

  .header-layout__nav {
    grid-area: nav;
    width: 100%;
  }

  .header-layout__theme {
    grid-area: theme;
    justify-self: end;
  }

  .header-nav-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 640px) {
    .header-layout {
      grid-template-columns: auto 1fr auto;
      grid-template-areas: "logos nav theme";
      gap: 0 1rem;
    }

    .header-layout__logos {
      justify-self: start;
    }
  }

  .header-nav-scroll {
    overflow-x: auto;
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  .header-nav-scroll::-webkit-scrollbar {
    display: none;
  }

  .header-nav-link {
    font-size: 0.85rem;
    line-height: 1.25;
  }

  @media (min-width: 1024px) {
    .header-nav-link {
      font-size: 0.9375rem;
    }
  }

  .header-logos-link {
    margin: 0;
    padding: 0;
  }

  .header-logos {
    line-height: 0;
    margin: 0;
  }

  .header-logo-wrap {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    background: transparent;
    border: none;
    box-shadow: none;
    padding: 0;
    line-height: 0;
  }

  .header-logo-wrap--knc {
    overflow: visible;
    margin-left: 0;
  }

  .header-logo-wrap--cajasol {
    overflow: visible;
  }

  .header-logo {
    display: block;
    width: auto;
    object-fit: contain;
    object-position: center center;
    transition: transform 0.3s ease;
  }

  .header-logo--knc {
    width: auto;
    height: auto;
    max-height: 5.5rem;
    max-width: min(50vw, 12rem);
    margin-left: 0;
    margin-top: -1.1rem;
    margin-bottom: -1.1rem;
    transform-origin: center center;
    object-position: center center;
    filter: drop-shadow(0 1px 2px rgba(15, 23, 42, 0.12));
    transition: transform 0.3s ease, filter 0.3s ease;
  }

  .header-logo--cajasol {
    width: auto;
    height: auto;
    max-height: 4.5rem;
    max-width: min(40vw, 9.5rem);
    margin-top: -0.85rem;
    margin-bottom: -0.85rem;
    transform-origin: center center;
    object-position: center center;
    filter: drop-shadow(0 1px 2px rgba(15, 23, 42, 0.1));
    transition: transform 0.3s ease, filter 0.3s ease;
  }

  html.dark .header-logo--knc,
  html.dark .header-logo--cajasol {
    filter: brightness(0) invert(1);
  }

  .group:hover .header-logo--knc,
  .group:hover .header-logo--cajasol {
    transform: scale(1.03);
  }

  html.dark .group:hover .header-logo--knc,
  html.dark .group:hover .header-logo--cajasol {
    filter: brightness(0) invert(1) drop-shadow(0 0 8px rgba(212, 175, 55, 0.45));
  }

  @media (min-width: 640px) {
    .header-logo--knc {
      width: auto;
      height: 5rem;
      max-height: none;
      max-width: none;
      margin-top: -1.575rem;
      margin-bottom: -1.575rem;
      transform-origin: left center;
      object-position: left center;
    }

    .header-logo--cajasol {
      width: auto;
      height: 4.25rem;
      max-height: none;
      max-width: none;
      margin-top: -1.25rem;
      margin-bottom: -1.25rem;
      transform-origin: left center;
      object-position: left center;
    }
  }

  @media (min-width: 1024px) {
    .header-logo--knc {
      height: 5.5rem;
      margin-top: -1.8rem;
      margin-bottom: -1.8rem;
    }

    .header-logo--cajasol {
      height: 4.5rem;
      margin-top: -1.35rem;
      margin-bottom: -1.35rem;
    }
  }
</style>
