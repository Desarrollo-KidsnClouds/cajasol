---
const navLinks = [
  { href: "#inicio", label: "Presentación" },
  { href: "#presentacion", label: "Timeline" },
  { href: "#embudo", label: "Resultados" },
  { href: "#producto", label: "Producto" },
  { href: "#cobertura", label: "Mapa" },
  { href: "#repercusion", label: "Repercusión" },
];
---

<header
  class="site-header no-print relative z-50 mx-auto w-[calc(100%-2rem)] max-w-5xl py-3 transition-all duration-300 sm:fixed sm:inset-x-0 sm:top-0 sm:w-[calc(100%-4rem)] sm:max-w-5xl sm:py-2"
>
  <div class="site-header-inner header-layout w-full overflow-visible rounded-2xl border border-slate-200/80 bg-white/90 px-3 py-1.5 shadow-[0_4px_16px_rgba(15,23,42,0.08)] backdrop-blur-xl dark:border-[rgba(212,175,55,0.15)] dark:bg-[#0f0f0f]/90 dark:shadow-[0_4px_24px_rgba(0,0,0,0.5)] sm:px-5 sm:py-1.5 lg:px-6">
    <a
      href="#inicio"
      class="header-logos-link header-layout__logos group flex shrink-0 items-center"
      aria-label="Kids&Clouds y Fundación Cajasol — Inicio"
    >
      <div class="header-logos flex shrink-0 items-center gap-1 sm:gap-1.5" aria-label="Kids&Clouds y Fundación Cajasol">
        <span class="header-logo-wrap header-logo-wrap--knc">
          <img
            src="/logo_web_nuevo.png"
            alt="Logo Kids&Clouds"
            width="320"
            height="104"
            class="header-logo header-logo--knc"
            loading="eager"
            decoding="async"
          />
        </span>
        <span class="header-logo-wrap header-logo-wrap--cajasol">
          <img
            src="/Logo_Fundación_Cajasol.png"
            alt="Logo Fundación Cajasol"
            width="240"
            height="84"
            class="header-logo header-logo--cajasol"
            loading="eager"
            decoding="async"
          />
        </span>
      </div>
    </a>

    <nav
      id="mainNav"
      class="header-nav-scroll header-layout__nav hidden min-w-0 border-l border-slate-200/70 pl-3 dark:border-[rgba(212,175,55,0.1)] sm:block md:pl-4"
      aria-label="Navegación principal"
    >
      <ul class="flex items-center gap-2.5 pr-1 sm:gap-3 md:gap-4 lg:gap-4">
        {
          navLinks.map((link) => (
            <li class="shrink-0">
              <a
                href={link.href}
                class="header-nav-link whitespace-nowrap rounded-md px-2 py-1 font-medium text-slate-500 transition-colors hover:text-slate-900 dark:text-[#6b6b6b] dark:hover:text-white"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <button
      id="themeToggle"
      type="button"
      class="theme-toggle header-layout__theme inline-flex h-8 w-8 shrink-0 items-center justify-center self-center rounded-lg border border-[rgba(212,175,55,0.2)] bg-transparent text-[#6b6b6b] transition hover:border-[#D4AF37]/50 hover:text-[#D4AF37] sm:h-9 sm:w-9"
      aria-label="Activar modo oscuro"
      aria-pressed="false"
      title="Modo oscuro"
    >
      <svg class="icon-sun h-[1rem] w-[1rem]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
      </svg>
      <svg class="icon-moon h-[1rem] w-[1rem]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
      </svg>
    </button>
  </div>
</header>

<div class="site-header-spacer no-print hidden sm:block" aria-hidden="true"></div>

<!-- ── Barra de navegación inferior (solo móvil) ── -->
<nav
  class="no-print mobile-bottom-nav fixed bottom-0 left-0 right-0 z-50 sm:hidden"
  aria-label="Navegación móvil"
>
  <div class="border-t border-slate-200/90 bg-white/96 px-1 pb-safe pt-1 backdrop-blur-xl dark:border-[rgba(212,175,55,0.2)] dark:bg-[#0f0f0f]/96">
    <ul class="grid grid-cols-6 items-center">
      {
        navLinks.map((link, i) => {
          const icons = [
            /* Presentación */
            `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>`,
            /* Timeline */
            `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>`,
            /* Resultados */
            `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>`,
            /* Producto */
            `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>`,
            /* Mapa */
            `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"/><line x1="8" y1="2" x2="8" y2="18"/><line x1="16" y1="6" x2="16" y2="22"/></svg>`,
            /* Repercusión */
            `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8h1a4 4 0 0 1 0 8h-1"/><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/><line x1="6" y1="1" x2="6" y2="4"/><line x1="10" y1="1" x2="10" y2="4"/><line x1="14" y1="1" x2="14" y2="4"/></svg>`,
          ];
          return (
            <li>
              <a href={link.href} class="mobile-nav-item flex flex-col items-center gap-0.5 py-2">
                <span class="mobile-nav-icon" set:html={icons[i]} />
                <span class="mobile-nav-label">{link.label}</span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</nav>

<style>
  /* Reserva espacio en escritorio: el header es fixed y sale del flujo del documento */
  .site-header-spacer {
    height: 5rem;
  }

  @media (min-width: 1024px) {
    .site-header-spacer {
      height: 5.5rem;
    }
  }

  .header-layout {
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-areas: "logos nav theme";
    gap: 0 0.75rem;
    align-items: center;
  }

  .header-layout__logos {
    grid-area: logos;
  }

  .header-layout__nav {
    grid-area: nav;
    width: 100%;
  }

  .header-layout__theme {
    grid-area: theme;
    justify-self: end;
  }

  @media (min-width: 640px) {
    .header-layout {
      gap: 0 1rem;
    }
  }

  .header-nav-scroll {
    overflow-x: auto;
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .header-nav-scroll::-webkit-scrollbar {
    display: none;
  }

  .header-nav-link {
    font-size: 0.72rem;
    line-height: 1.25;
  }

  @media (min-width: 640px) {
    .header-nav-link {
      font-size: 0.85rem;
    }
  }

  @media (min-width: 1024px) {
    .header-nav-link {
      font-size: 0.9375rem;
    }
  }

  .header-logos-link {
    margin: 0;
    padding: 0;
  }

  .header-logos {
    line-height: 0;
    margin: 0;
  }

  .header-logo-wrap {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    background: transparent;
    border: none;
    box-shadow: none;
    padding: 0;
    line-height: 0;
  }

  .header-logo-wrap--knc {
    overflow: visible;
    margin-left: 0;
  }

  .header-logo-wrap--cajasol {
    overflow: visible;
  }

  .header-logo {
    display: block;
    width: auto;
    object-fit: contain;
    object-position: center center;
    transition: transform 0.3s ease;
  }

  .header-logo--knc {
    height: 3rem;
    margin-left: 0;
    margin-top: -0.6rem;
    margin-bottom: -0.6rem;
    transform-origin: left center;
    object-position: left center;
    filter: drop-shadow(0 1px 2px rgba(15, 23, 42, 0.12));
    transition: transform 0.3s ease, filter 0.3s ease;
  }

  .header-logo--cajasol {
    height: 2.5rem;
    max-width: none;
    margin-top: -0.4rem;
    margin-bottom: -0.4rem;
    transform-origin: left center;
    object-position: left center;
    filter: drop-shadow(0 1px 2px rgba(15, 23, 42, 0.1));
    transition: transform 0.3s ease, filter 0.3s ease;
  }

  /* Modo oscuro: logos en blanco */
  html.dark .header-logo--knc,
  html.dark .header-logo--cajasol {
    filter: brightness(0) invert(1);
  }

  .group:hover .header-logo--knc,
  .group:hover .header-logo--cajasol {
    transform: scale(1.03);
  }

  html.dark .group:hover .header-logo--knc,
  html.dark .group:hover .header-logo--cajasol {
    filter: brightness(0) invert(1) drop-shadow(0 0 8px rgba(212, 175, 55, 0.45));
  }

  @media (min-width: 640px) {
    .header-logo--knc {
      height: 3.25rem;
      margin-top: -0.7rem;
      margin-bottom: -0.7rem;
    }
    .header-logo--cajasol {
      height: 2.75rem;
      margin-top: -0.5rem;
      margin-bottom: -0.5rem;
    }
  }

  @media (min-width: 1024px) {
    .header-logo--knc {
      height: 3.5rem;
      margin-top: -0.8rem;
      margin-bottom: -0.8rem;
    }
    .header-logo--cajasol {
      height: 3rem;
      margin-top: -0.6rem;
      margin-bottom: -0.6rem;
    }
  }

  /* ── Barra inferior móvil ── */
  .mobile-bottom-nav {
    /* soporte para el safe area de iPhone (barra de inicio) */
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }

  .pb-safe {
    padding-bottom: max(env(safe-area-inset-bottom, 0px), 4px);
  }

  .mobile-nav-item {
    color: #94a3b8;
    text-decoration: none;
    transition: color 0.2s ease;
    -webkit-tap-highlight-color: transparent;
    width: 100%;
  }

  .mobile-nav-item:active,
  .mobile-nav-item:hover {
    color: #f0b552;
  }

  html.dark .mobile-nav-item {
    color: #6b7280;
  }

  html.dark .mobile-nav-item:active,
  html.dark .mobile-nav-item:hover {
    color: #f0b552;
  }

  .mobile-nav-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.25rem;
    height: 1.25rem;
  }

  .mobile-nav-icon :global(svg) {
    width: 1.2rem;
    height: 1.2rem;
  }

  .mobile-nav-label {
    font-size: 0.55rem;
    font-weight: 600;
    line-height: 1;
    text-align: center;
    letter-spacing: 0.01em;
    font-family: 'Poppins', sans-serif;
    white-space: nowrap;
  }
</style>
