---
const navLinks = [
  { href: "#inicio", label: "Presentación" },
  { href: "#presentacion", label: "Timeline" },
  { href: "#embudo", label: "Resultados" },
  { href: "#cobertura", label: "Mapa" },
  { href: "#repercusion", label: "Repercusión" },
];
---

<header
  class="site-header no-print relative z-50 mx-auto w-[calc(100%-2rem)] max-w-5xl py-3 transition-all duration-300 sm:fixed sm:inset-x-0 sm:top-0 sm:w-[calc(100%-4rem)] sm:max-w-5xl sm:py-2"
>
  <div class="site-header-inner w-full overflow-visible rounded-2xl border border-slate-200/80 bg-white/90 px-3 py-1.5 shadow-[0_4px_16px_rgba(15,23,42,0.08)] backdrop-blur-xl dark:border-[rgba(212,175,55,0.15)] dark:bg-[#0f0f0f]/90 dark:shadow-[0_4px_24px_rgba(0,0,0,0.5)] sm:px-5 sm:py-1.5 lg:px-6">
    <div class="header-layout w-full">
    <button
      id="mobileMenuToggle"
      type="button"
      class="header-layout__menu mobile-menu-toggle sm:hidden"
      aria-label="Abrir menú de navegación"
      aria-expanded="false"
      aria-controls="mobileMenu"
    >
      <span class="mobile-menu-toggle__icon" aria-hidden="true">
        <span class="mobile-menu-toggle__bar"></span>
        <span class="mobile-menu-toggle__bar"></span>
        <span class="mobile-menu-toggle__bar"></span>
      </span>
    </button>

    <a
      href="#inicio"
      class="header-logos-link header-layout__logos group flex shrink-0 items-center"
      aria-label="Kids&Clouds y Fundación Cajasol — Inicio"
    >
      <div class="header-logos flex shrink-0 items-center gap-2 sm:gap-2.5" aria-label="Kids&Clouds y Fundación Cajasol">
        <span class="header-logo-wrap header-logo-wrap--knc">
          <img
            src="/logo_web_nuevo.png"
            alt="Logo Kids&Clouds"
            width="320"
            height="104"
            class="header-logo header-logo--knc"
            loading="eager"
            decoding="async"
          />
        </span>
        <span class="header-logo-wrap header-logo-wrap--cajasol">
          <img
            src="/Logo_Fundación_Cajasol.png"
            alt="Logo Fundación Cajasol"
            width="240"
            height="84"
            class="header-logo header-logo--cajasol"
            loading="eager"
            decoding="async"
          />
        </span>
      </div>
    </a>

    <nav
      id="mainNav"
      class="header-nav-scroll header-layout__nav hidden min-w-0 border-l border-slate-200/70 pl-3 dark:border-[rgba(212,175,55,0.1)] sm:block md:pl-4"
      aria-label="Navegación principal"
    >
      <ul class="flex items-center gap-2.5 pr-1 sm:gap-3 md:gap-4 lg:gap-4">
        {
          navLinks.map((link) => (
            <li class="shrink-0">
              <a
                href={link.href}
                class="header-nav-link whitespace-nowrap rounded-md px-2 py-1 font-medium text-slate-500 transition-colors hover:text-slate-900 dark:text-[#6b6b6b] dark:hover:text-white"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <button
      id="themeToggle"
      type="button"
      class="theme-toggle header-layout__theme inline-flex h-8 w-8 shrink-0 items-center justify-center self-center rounded-lg border border-[rgba(212,175,55,0.2)] bg-transparent text-[#6b6b6b] transition hover:border-[#D4AF37]/50 hover:text-[#D4AF37] sm:h-9 sm:w-9"
      aria-label="Activar modo oscuro"
      aria-pressed="false"
      title="Modo oscuro"
    >
      <svg class="icon-sun h-[1rem] w-[1rem]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
      </svg>
      <svg class="icon-moon h-[1rem] w-[1rem]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
      </svg>
    </button>
    </div>

    <nav
      id="mobileMenu"
      class="mobile-menu-panel hidden sm:hidden"
      aria-label="Menú móvil"
      hidden
    >
      <ul class="mobile-menu-list">
        {
          navLinks.map((link) => (
            <li>
              <a href={link.href} class="mobile-menu-link header-nav-link">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<div class="site-header-spacer no-print hidden sm:block" aria-hidden="true"></div>

<script>
  const mobileMenuToggle = document.getElementById("mobileMenuToggle");
  const mobileMenu = document.getElementById("mobileMenu");

  const setMobileMenuOpen = (open: boolean) => {
    if (!mobileMenuToggle || !mobileMenu) return;
    mobileMenuToggle.setAttribute("aria-expanded", String(open));
    mobileMenuToggle.setAttribute(
      "aria-label",
      open ? "Cerrar menú de navegación" : "Abrir menú de navegación"
    );
    mobileMenuToggle.classList.toggle("is-open", open);
    mobileMenu.hidden = !open;
    mobileMenu.classList.toggle("hidden", !open);
    document.body.classList.toggle("mobile-menu-open", open);
  };

  mobileMenuToggle?.addEventListener("click", () => {
    const isOpen = mobileMenuToggle.getAttribute("aria-expanded") === "true";
    setMobileMenuOpen(!isOpen);
  });

  mobileMenu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => setMobileMenuOpen(false));
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && mobileMenuToggle?.getAttribute("aria-expanded") === "true") {
      setMobileMenuOpen(false);
    }
  });

  window.matchMedia("(min-width: 640px)").addEventListener("change", (event) => {
    if (event.matches) setMobileMenuOpen(false);
  });
</script>

<style>
  /* Reserva espacio en escritorio: el header es fixed y sale del flujo del documento */
  .site-header-spacer {
    height: 5rem;
  }

  @media (min-width: 1024px) {
    .site-header-spacer {
      height: 5.5rem;
    }
  }

  .header-layout {
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-areas: "menu logos theme";
    gap: 0 0.5rem;
    align-items: center;
  }

  .header-layout__menu {
    grid-area: menu;
    justify-self: start;
  }

  .header-layout__logos {
    grid-area: logos;
    justify-self: center;
  }

  .header-layout__nav {
    grid-area: nav;
    width: 100%;
  }

  .header-layout__theme {
    grid-area: theme;
    justify-self: end;
  }

  @media (min-width: 640px) {
    .header-layout {
      grid-template-areas: "logos nav theme";
      gap: 0 1rem;
    }

    .header-layout__logos {
      justify-self: start;
    }

    .mobile-menu-toggle,
    .header-layout__menu {
      display: none !important;
    }

    .mobile-menu-panel {
      display: none !important;
    }
  }

  .mobile-menu-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 1px solid rgba(212, 175, 55, 0.2);
    border-radius: 0.5rem;
    background: transparent;
    color: #6b6b6b;
    cursor: pointer;
    transition: border-color 0.2s ease, color 0.2s ease;
    -webkit-tap-highlight-color: transparent;
  }

  .mobile-menu-toggle:hover,
  .mobile-menu-toggle:focus-visible {
    border-color: rgba(212, 175, 55, 0.5);
    color: #d4af37;
    outline: none;
  }

  .mobile-menu-toggle__icon {
    position: relative;
    display: block;
    width: 1.125rem;
    height: 1.125rem;
  }

  .mobile-menu-toggle__bar {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 2px;
    margin-top: -1px;
    border-radius: 1px;
    background: currentColor;
    transform-origin: center center;
    transition: transform 0.22s ease, opacity 0.15s ease;
  }

  .mobile-menu-toggle__bar:nth-child(1) {
    transform: translateY(-5px);
  }

  .mobile-menu-toggle__bar:nth-child(3) {
    transform: translateY(5px);
  }

  .mobile-menu-toggle.is-open .mobile-menu-toggle__bar:nth-child(1) {
    transform: rotate(45deg);
  }

  .mobile-menu-toggle.is-open .mobile-menu-toggle__bar:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }

  .mobile-menu-toggle.is-open .mobile-menu-toggle__bar:nth-child(3) {
    transform: rotate(-45deg);
  }

  .mobile-menu-panel {
    margin-top: 0.5rem;
    padding-top: 0.5rem;
    border-top: 1px solid rgba(148, 163, 184, 0.25);
  }

  html.dark .mobile-menu-panel {
    border-top-color: rgba(212, 175, 55, 0.15);
  }

  .mobile-menu-list {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mobile-menu-link {
    display: block;
    padding: 0.625rem 0.5rem;
    font-size: 0.9rem;
    border-radius: 0.5rem;
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .mobile-menu-link:hover,
  .mobile-menu-link:focus-visible {
    background: rgba(212, 175, 55, 0.08);
    outline: none;
  }

  .header-nav-scroll {
    overflow-x: auto;
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .header-nav-scroll::-webkit-scrollbar {
    display: none;
  }

  .header-nav-link {
    font-size: 0.72rem;
    line-height: 1.25;
  }

  @media (min-width: 640px) {
    .header-nav-link {
      font-size: 0.85rem;
    }
  }

  @media (min-width: 1024px) {
    .header-nav-link {
      font-size: 0.9375rem;
    }
  }

  .header-logos-link {
    margin: 0;
    padding: 0;
  }

  .header-logos {
    line-height: 0;
    margin: 0;
  }

  .header-logo-wrap {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    background: transparent;
    border: none;
    box-shadow: none;
    padding: 0;
    line-height: 0;
  }

  .header-logo-wrap--knc {
    overflow: visible;
    margin-left: 0;
  }

  .header-logo-wrap--cajasol {
    overflow: visible;
  }

  .header-logo {
    display: block;
    width: auto;
    object-fit: contain;
    object-position: center center;
    transition: transform 0.3s ease;
  }

  .header-logo--knc {
    width: auto;
    height: auto;
    max-height: 5.5rem;
    max-width: min(50vw, 12rem);
    margin-left: 0;
    margin-top: -1.1rem;
    margin-bottom: -1.1rem;
    transform-origin: center center;
    object-position: center center;
    filter: drop-shadow(0 1px 2px rgba(15, 23, 42, 0.12));
    transition: transform 0.3s ease, filter 0.3s ease;
  }

  .header-logo--cajasol {
    width: auto;
    height: auto;
    max-height: 4.5rem;
    max-width: min(40vw, 9.5rem);
    margin-top: -0.85rem;
    margin-bottom: -0.85rem;
    transform-origin: center center;
    object-position: center center;
    filter: drop-shadow(0 1px 2px rgba(15, 23, 42, 0.1));
    transition: transform 0.3s ease, filter 0.3s ease;
  }

  /* Modo oscuro: logos en blanco */
  html.dark .header-logo--knc,
  html.dark .header-logo--cajasol {
    filter: brightness(0) invert(1);
  }

  .group:hover .header-logo--knc,
  .group:hover .header-logo--cajasol {
    transform: scale(1.03);
  }

  html.dark .group:hover .header-logo--knc,
  html.dark .group:hover .header-logo--cajasol {
    filter: brightness(0) invert(1) drop-shadow(0 0 8px rgba(212, 175, 55, 0.45));
  }

  @media (min-width: 640px) {
    .header-logo--knc {
      width: auto;
      height: 5rem;
      max-height: none;
      max-width: none;
      margin-top: -1.575rem;
      margin-bottom: -1.575rem;
      transform-origin: left center;
      object-position: left center;
    }
    .header-logo--cajasol {
      width: auto;
      height: 4.25rem;
      max-height: none;
      max-width: none;
      margin-top: -1.25rem;
      margin-bottom: -1.25rem;
      transform-origin: left center;
      object-position: left center;
    }
  }

  @media (min-width: 1024px) {
    .header-logo--knc {
      height: 5.5rem;
      margin-top: -1.8rem;
      margin-bottom: -1.8rem;
    }
    .header-logo--cajasol {
      height: 4.5rem;
      margin-top: -1.35rem;
      margin-bottom: -1.35rem;
    }
  }

</style>
