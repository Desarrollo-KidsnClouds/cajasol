---
const bars = [
  {
    label: "Avance sobre objetivo de centros implantados (15 / 70)",
    value: "95%",
    width: "21%",
  },
  {
    label: "Cobertura de centros ya contactados",
    value: "100%",
    width: "100%",
  },
  {
    label: "Centros con presentación pendiente en pipeline",
    value: "54",
    width: "61%",
  },
  {
    label: "Actividad de webinars ejecutada",
    value: "54",
    width: "77%",
  },
];

interface Props {
  embedded?: boolean;
}

const { embedded = false } = Astro.props;
const Tag = embedded ? "div" : "section";
const outerClass = embedded
  ? "flex h-full min-w-0 flex-col"
  : "mx-auto w-full max-w-6xl px-5";
---

<Tag
  id="seguimiento"
  class={outerClass}
  aria-label="Estado de avance del convenio"
>
  <header class="reveal mb-3">
    <p class="section-eyebrow">Seguimiento</p>
    <h2 class:list={["section-title mt-2", embedded && "text-lg sm:text-xl"]}>
      Nivel de progreso frente a hitos del convenio
    </h2>
  </header>

  <div class:list={["reveal-scale card-fx shine-border panel-glass p-4", embedded && "flex-1"]}>
    <div class="space-y-3">
      {
        bars.map((bar, index) => (
          <article class="group transition duration-300 hover:translate-x-1" data-reveal-delay={`${index * 80}ms`}>
            <div class="mb-2 flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between sm:gap-3">
              <h3 class="text-xs font-semibold leading-snug text-slate-600 transition group-hover:text-slate-900 dark:text-slate-300 dark:group-hover:text-white sm:text-sm">
                {bar.label}
              </h3>
              <span class="shrink-0 text-sm font-bold text-slate-900 transition group-hover:scale-110 group-hover:text-blue-600 dark:text-white dark:group-hover:text-blue-300">
                {bar.value}
              </span>
            </div>
            <div class="progress-track">
              <div
                class="progress-fill progress-fill-glow"
                data-target-width={bar.width}
                style="width: 0%;"
              >
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</Tag>
