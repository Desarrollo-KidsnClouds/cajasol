---
const stages = [
  { label: "Contactados",        legendLabel: "Centros educativos contactados",  value: 296, conv: null,  convNote: null,                            fill: "#4338ca", fillLight: "#818cf8", icon: "📋" },
  { label: "A formación",        legendLabel: "Centros invitados a formación",   value: 80,  conv: "27%", convNote: "de contactados",                fill: "#2563eb", fillLight: "#60a5fa", icon: "🎓" },
  { label: "Con reunión",        legendLabel: "Reuniones de presentación",       value: 45,  conv: "56%", convNote: "de invitados",                  fill: "#0891b2", fillLight: "#38bdf8", icon: "🤝" },
  { label: "Implantados",        legendLabel: "Centros implantados activos",     value: 16,  conv: "36%", convNote: "de reuniones",                  fill: "#b45309", fillLight: "#f0b552", icon: "✅" },
];

const targetCenters = 70;
const implanted = stages[stages.length - 1].value;
const n = stages.length;
const ROW_H = 69;
const GAP   = 4;

function pct(num: number, den: number) {
  if (!den) return "—";
  const p = (num / den) * 100;
  return p >= 10 ? `${Math.round(p)}%` : `${p.toFixed(1).replace(".",",")}%`;
}

// Clip-path trapezoids: maxWidth% → minWidth%
const maxW = 100, minW = 32;
const segData = stages.map((s, i) => {
  const tW = maxW - (maxW - minW) * i / n;
  const bW = maxW - (maxW - minW) * (i + 1) / n;
  const tL = (100 - tW) / 2, bL = (100 - bW) / 2;
  return {
    ...s,
    clip: `polygon(${tL.toFixed(1)}% 0%,${(tL+tW).toFixed(1)}% 0%,${(bL+bW).toFixed(1)}% 100%,${bL.toFixed(1)}% 100%)`,
  };
});

const containerH = n * ROW_H + (n - 1) * GAP;
const implantedPct = pct(implanted, targetCenters);
---

<section id="embudo" class="mx-auto w-full max-w-6xl px-5" aria-label="Embudo de conversión comercial">
  <header class="reveal mb-3">
    <p class="section-eyebrow section-eyebrow--amber">Centros educativos</p>
    <h2 class="section-title mt-1">Del contacto a la implantación</h2>
  </header>

  <div class="funnel-chart-card reveal-scale card-fx shine-border panel-glass p-4">

    <!-- Barra de progreso resumen -->
    <div class="mb-4 flex items-center gap-3">
      <div class="flex-1 overflow-hidden rounded-full bg-slate-200 dark:bg-slate-700" style="height:6px;">
        <div style={`width:${implantedPct}; height:100%; background:linear-gradient(90deg,#f0b552,#b45309); border-radius:9999px;`}></div>
      </div>
      <span class="shrink-0 text-xs font-bold text-amber-600 dark:text-amber-400">{implanted}/{targetCenters} implantados — {implantedPct}</span>
    </div>

    <!-- Grid principal -->
    <div class="funnel-main-grid">

      <!-- ── Pirámide (izquierda) ── -->
      <div class="funnel-pyramid-col">
        {segData.map((seg) => (
          <div class="funnel-row" style="position:relative; overflow:hidden; border-radius:6px;">
            <!-- Fondo trapezoidal -->
            <div style={`position:absolute; inset:0; background:linear-gradient(160deg,${seg.fillLight},${seg.fill}); clip-path:${seg.clip}; box-shadow: inset 0 1px 0 rgba(255,255,255,0.2);`}></div>
            <!-- Número centrado -->
            <div style="position:absolute; inset:0; display:flex; align-items:center; justify-content:center;">
              <span class="pyr-val" style="font-family:'Poppins',sans-serif; font-weight:800; color:#fff; line-height:1; text-shadow:0 1px 4px rgba(0,0,0,0.5);">{seg.value}</span>
            </div>
          </div>
        ))}
      </div>

      <!-- ── Tarjetas (derecha) ── -->
      <div class="funnel-cards-col">
        {segData.map((seg, i) => (
          <div
            class="funnel-card funnel-row"
            style={`border-left:3px solid ${seg.fill};`}
          >
            <div style="display:flex; align-items:center; justify-content:space-between; gap:10px; width:100%;">
              <!-- Info -->
              <div style="min-width:0; flex:1;">
                <p class="fc-title">{seg.legendLabel}</p>
                <p class="fc-meta">
                  {seg.conv ? (
                    <>
                      <span class="fc-badge fc-badge--conv" style={`background:${seg.fill}22; color:${seg.fill};`}>{seg.conv}</span>
                      {seg.convNote}
                    </>
                  ) : (
                    <span class="fc-badge fc-badge--start">Punto de partida</span>
                  )}
                </p>
              </div>
              <!-- Número -->
              <div style="text-align:right; flex-shrink:0;">
                <span class="fc-num" style={`color:${seg.fill};`}>{seg.value}</span>
                {i > 0 && (
                  <p class="fc-ofTotal">{pct(seg.value, stages[0].value)} del total</p>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>

    </div>
  </div>
</section>

<style>
  @media (max-width: 640px) {
    #embudo .section-title {
      white-space: nowrap;
      font-size: clamp(1rem, 5.5vw, 1.35rem);
    }
  }

  #embudo .funnel-chart-card {
    width: 105%;
    max-width: 105%;
    margin-inline: auto;
  }

  .funnel-card {
    background: rgba(248,250,252,0.9);
    border-top: 1px solid rgba(226,232,240,0.8);
    border-right: 1px solid rgba(226,232,240,0.8);
    border-bottom: 1px solid rgba(226,232,240,0.8);
    transition: background 0.2s;
  }
  html.dark .funnel-card {
    background: rgba(15,23,42,0.6);
    border-top: 1px solid rgba(51,65,85,0.5);
    border-right: 1px solid rgba(51,65,85,0.5);
    border-bottom: 1px solid rgba(51,65,85,0.5);
  }
  .funnel-card:hover {
    background: rgba(241,245,249,1);
  }
  html.dark .funnel-card:hover {
    background: rgba(30,41,59,0.7);
  }

  .fc-title {
    font-size: 0.75rem;
    font-weight: 600;
    color: #1e293b;
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  html.dark .fc-title { color: #e2e8f0; }

  .fc-meta {
    margin-top: 3px;
    font-size: 0.63rem;
    color: #64748b;
    display: flex;
    align-items: center;
    gap: 5px;
    flex-wrap: wrap;
  }
  html.dark .fc-meta { color: #94a3b8; }

  .fc-badge {
    border-radius: 4px;
    padding: 1px 5px;
    font-size: 0.6rem;
    font-weight: 700;
  }
  .fc-badge--conv {}
  .fc-badge--start {
    background: rgba(148,163,184,0.15);
    color: #64748b;
  }
  html.dark .fc-badge--start {
    background: rgba(100,116,139,0.2);
    color: #94a3b8;
  }

  .fc-num {
    font-family: 'Poppins', sans-serif;
    font-size: 1.47rem;
    font-weight: 800;
    line-height: 1;
    display: block;
  }

  .fc-ofTotal {
    font-size: 0.6rem;
    color: #94a3b8;
    margin-top: 1px;
    text-align: right;
  }
  html.dark .fc-ofTotal { color: #64748b; }

  /* ── Grid principal ── */
  .funnel-main-grid {
    display: grid;
    grid-template-columns: 210px 1fr;
    gap: 13px;
  }

  .funnel-pyramid-col,
  .funnel-cards-col {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  /* ── Fila (misma altura en ambas columnas) ── */
  .funnel-row {
    min-height: 65px;
    flex: 1;
  }

  .funnel-card {
    display: flex;
    align-items: center;
    padding: 0 12px;
    border-radius: 8px;
  }

  /* ── Texto pirámide ── */
  .pyr-val { font-size: 1.155rem; }
  .pyr-lbl { font-size: 0.55rem; }

  /* ── Tablet ── */
  @media (max-width: 640px) {
    .funnel-main-grid { grid-template-columns: 110px 1fr; gap: 8px; }
    .funnel-row { min-height: 64px; }
    .pyr-val { font-size: 0.9rem; }
    .pyr-lbl { font-size: 0.46rem; }
    .fc-title { font-size: 0.82rem; white-space: normal; }
    .fc-meta { font-size: 0.76rem; }
    .fc-badge { font-size: 0.72rem; padding: 2px 6px; }
    .fc-num { font-size: 1.5rem; }
    .fc-ofTotal { display: none; }
  }

  /* ── Móvil ── */
  @media (max-width: 420px) {
    .funnel-main-grid { grid-template-columns: 80px 1fr; gap: 6px; }
    .funnel-row { min-height: 62px; }
    .pyr-val { font-size: 0.78rem; }
    .pyr-lbl { font-size: 0.38rem; }
    .fc-title { font-size: 0.78rem; white-space: normal; }
    .fc-meta { display: flex; font-size: 0.72rem; }
    .fc-badge { font-size: 0.68rem; padding: 2px 6px; }
    .fc-num { font-size: 1.4rem; }
    .funnel-card { padding: 4px 8px; align-items: center; }
  }
</style>
