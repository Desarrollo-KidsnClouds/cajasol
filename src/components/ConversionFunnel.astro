---
const stages = [
  { label: "Centros contactados", value: 296, fill: "#64748b", fillLight: "#94a3b8", conv: null },
  { label: "Webinars realizados", value: 54, fill: "#3b82f6", fillLight: "#60a5fa", conv: "18,2%" },
  { label: "Demos de presentación", value: 45, fill: "#6366f1", fillLight: "#818cf8", conv: "83,3%" },
  { label: "Centros firmados", value: 16, fill: "#8b5cf6", fillLight: "#a78bfa", conv: "35,6%" },
  { label: "Centros implantados", value: 15, fill: "#10b981", fillLight: "#34d399", conv: "93,8%" },
];

const targetCenters = 70;
const implanted = 15;
const inManagement = 75;
const progressPct = Math.round((implanted / targetCenters) * 100);
const globalRate = ((stages[4].value / stages[0].value) * 100).toFixed(1).replace(".", ",");

const cx = 250;
const segH = 62;
const gap = 5;
const startY = 20;
const maxHalf = 200;
const minHalf = 48;

const segments = stages.map((stage, i) => {
  const y1 = startY + i * (segH + gap);
  const y2 = y1 + segH;
  const w1 = maxHalf - ((maxHalf - minHalf) * i) / stages.length;
  const w2 = maxHalf - ((maxHalf - minHalf) * (i + 1)) / stages.length;
  const path = `M ${cx - w1} ${y1} L ${cx + w1} ${y1} L ${cx + w2} ${y2} L ${cx - w2} ${y2} Z`;
  const midY = (y1 + y2) / 2;
  return { ...stage, path, y1, y2, midY, w1, w2, index: i };
});

const svgHeight = startY + stages.length * (segH + gap) + 12;
---

<section id="embudo" class="mx-auto w-full max-w-6xl px-5" aria-label="Embudo de conversión comercial">
  <header class="reveal mb-3">
    <p class="section-eyebrow section-eyebrow--indigo">Pipeline comercial</p>
    <h2 class="section-title mt-2">Del contacto al centro implantado</h2>
    <p class="mt-2 max-w-2xl text-sm text-slate-600 dark:text-slate-400">
      Visualización del recorrido comercial desde la captación hasta la implantación en centros.
    </p>
  </header>

  <div class="reveal-scale card-fx shine-border panel-glass overflow-hidden p-4 sm:p-6">
    <div class="mb-5 flex flex-wrap items-center justify-center gap-3 sm:justify-between">
      <div class="text-center sm:text-left">
        <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Objetivo del convenio</p>
        <p class="mt-1 text-xl font-bold text-slate-900 dark:text-white">
          <span class="bg-gradient-to-r from-blue-600 to-emerald-600 bg-clip-text text-transparent">{implanted}</span>
          <span class="text-slate-500"> / {targetCenters}</span> centros
        </p>
      </div>
      <div class="flex flex-wrap justify-center gap-2">
        <span class="badge-glow badge-glow--indigo">{progressPct}% objetivo</span>
        <span class="badge-glow badge-glow--amber">{inManagement} en gestión</span>
        <span class="rounded-full border border-emerald-500/30 bg-emerald-500/10 px-2.5 py-1 text-xs font-bold text-emerald-700 dark:text-emerald-300">
          {globalRate}% conversión total
        </span>
      </div>
    </div>

    <div id="funnel-chart" class="funnel-chart grid items-center gap-6 lg:grid-cols-[1fr_240px]">
      <div class="relative mx-auto w-full max-w-xl">
        <svg
          viewBox={`0 0 500 ${svgHeight}`}
          class="funnel-svg h-auto w-full max-h-[420px] drop-shadow-2xl"
          role="img"
          aria-label="Gráfico embudo: 296 contactados, 54 webinars, 45 demos, 16 firmados, 15 implantados"
        >
          <defs>
            {
              segments.map((seg) => (
                <linearGradient id={`funnel-grad-${seg.index}`} x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color={seg.fillLight} />
                  <stop offset="100%" stop-color={seg.fill} />
                </linearGradient>
              ))
            }
            <filter id="funnel-glow" x="-15%" y="-15%" width="130%" height="130%">
              <feDropShadow dx="0" dy="3" stdDeviation="5" flood-color="rgba(59,130,246,0.4)" />
            </filter>
          </defs>

          <ellipse cx={cx} cy={svgHeight - 4} rx={minHalf + 20} ry="8" fill="rgba(16,185,129,0.25)" class="funnel-base-glow" />

          {
            segments.map((seg) => (
              <g class="funnel-segment" data-segment-index={seg.index} style={`--delay: ${seg.index * 0.12}s`}>
                <path
                  d={seg.path}
                  fill={`url(#funnel-grad-${seg.index})`}
                  class="funnel-segment-path"
                  filter="url(#funnel-glow)"
                  stroke="rgba(255,255,255,0.15)"
                  stroke-width="1"
                />
                <text
                  x={cx}
                  y={seg.midY - 6}
                  text-anchor="middle"
                  class="funnel-segment-value"
                  fill="#ffffff"
                  font-size="22"
                  font-weight="800"
                >
                  {seg.value}
                </text>
                <text
                  x={cx}
                  y={seg.midY + 14}
                  text-anchor="middle"
                  class="funnel-segment-label"
                  fill="rgba(255,255,255,0.92)"
                  font-size="11"
                  font-weight="600"
                >
                  {seg.label}
                </text>
              </g>
            ))
          }
        </svg>

        <div class="pointer-events-none absolute inset-0 hidden items-center justify-center md:flex" aria-hidden="true">
          <div class="h-[85%] w-px bg-gradient-to-b from-transparent via-indigo-500/20 to-transparent"></div>
        </div>
      </div>

      <aside class="funnel-legend mx-auto w-full max-w-xs space-y-2 lg:max-w-none" data-scroll-stagger aria-label="Leyenda del embudo">
        {
          stages.map((stage, i) => (
            <div
              class="funnel-legend-item reveal flex items-center gap-3 rounded-xl border border-slate-200/80 bg-slate-50/80 px-3 py-2.5 transition duration-300 hover:scale-[1.02] hover:border-slate-300 hover:shadow-md dark:border-slate-700/60 dark:bg-slate-800/50"
              data-reveal-delay={`${i * 60}ms`}
            >
              <span
                class="h-10 w-1.5 shrink-0 rounded-full"
                style={`background: linear-gradient(180deg, ${stage.fillLight}, ${stage.fill})`}
              />
              <div class="min-w-0 flex-1">
                <p class="text-xs font-semibold text-slate-600 dark:text-slate-300">{stage.label}</p>
                <p class="text-lg font-extrabold text-slate-900 dark:text-white">{stage.value}</p>
              </div>
              {stage.conv ? (
                <span class="shrink-0 rounded-lg bg-indigo-500/10 px-2 py-1 text-[10px] font-bold text-indigo-600 dark:text-indigo-300">
                  {stage.conv}
                </span>
              ) : (
                <span class="shrink-0 text-[10px] font-semibold uppercase text-slate-400">Entrada</span>
              )}
            </div>
          ))
        }
      </aside>
    </div>
  </div>
</section>

<style>
  .funnel-segment-path {
    transition: filter 0.3s ease, opacity 0.5s ease;
  }

  .funnel-segment:hover .funnel-segment-path {
    filter: url(#funnel-glow) brightness(1.12);
  }

  .funnel-chart:not(.is-animated) .funnel-segment {
    opacity: 0;
    transform: translateY(12px);
  }

  .funnel-chart.is-animated .funnel-segment {
    animation: funnel-segment-in 0.7s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: var(--delay, 0s);
  }

  .funnel-chart.is-animated .funnel-base-glow {
    animation: funnel-glow-pulse 2.5s ease-in-out infinite;
  }

  @keyframes funnel-glow-pulse {
    0%,
    100% {
      opacity: 0.35;
    }
    50% {
      opacity: 0.7;
    }
  }

  @keyframes funnel-segment-in {
    from {
      opacity: 0;
      transform: translateY(16px) scale(0.96);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

</style>
