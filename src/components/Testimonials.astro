---
---

<section id="repercusion-medios" class="mx-auto w-full max-w-6xl px-5" aria-label="Repercusión en medios de comunicación">
  <header class="reveal mb-3">
    <div class="flex flex-wrap items-start justify-between gap-3 sm:gap-4">
      <div class="min-w-0 flex-1">
        <p class="section-eyebrow section-eyebrow--amber">Repercusión mediática</p>
        <h2 class="section-title mt-2">El impacto en los medios de comunicación</h2>
        <p class="mt-2 text-base text-slate-600 dark:text-slate-300 lg:whitespace-nowrap">
          Seguimiento de la visibilidad pública generada por la alianza en medios, asociaciones y canales digitales.
        </p>
      </div>
    </div>
  </header>

  <div
    class="repercusion-grid grid grid-cols-1 gap-3 sm:grid-cols-2 sm:gap-4 xl:grid-cols-3"
    data-scroll-stagger
  >
    <!-- Redes Sociales -->
    <article class="repercusion-card reveal-left card-fx shine-border panel-glass" data-reveal-delay="0ms">
      <div class="flex items-center gap-2 px-3 pt-3 sm:px-4 sm:pt-4">
        <span class="badge-glow badge-glow--amber repercusion-card__badge" style="margin:0;">Redes Sociales</span>
        <span class="repercusion-status-badge" role="status" aria-label="Próximamente">
          <span class="repercusion-status-badge__dot" aria-hidden="true"></span>
          Próximamente
        </span>
      </div>
      <div class="repercusion-card__media repercusion-card__media--full-image">
        <button
          type="button"
          class="gallery-card repercusion-visual img-reveal-zoom img-reveal-hover group h-full w-full cursor-zoom-in border-0 bg-transparent p-0"
          data-reveal-delay="180ms"
          aria-label="Ver fases de la alianza a tamaño completo"
        >
          <img
            src="/images/presentacion/cajasol-redes2.png"
            alt="Alianza Fundación Cajasol × Kids&Clouds — redes sociales"
            data-zoom-src="/images/presentacion/cajasol-redes2.png"
            class="repercusion-visual__img"
            loading="lazy"
            decoding="async"
          />
          <span class="repercusion-zoom-hint" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="7"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              <line x1="11" y1="8" x2="11" y2="14"></line>
              <line x1="8" y1="11" x2="14" y2="11"></line>
            </svg>
          </span>
        </button>
      </div>
      <div class="repercusion-card__body">
        <h3 class="repercusion-card__title">70 centros y 3.500 familias</h3>
        <p class="repercusion-card__text">
          La Fundación ha querido poner el foco en impulsar la transformación digital del sector educativo andaluz y en
          la conciliación laboral & familiar aliandose con la EdTech Kids&Clouds.
        </p>
        <div class="repercusion-card__footer repercusion-card__footer--spacer" aria-hidden="true"></div>
      </div>
    </article>

    <!-- Testimonio de dirección (placeholder) -->
    <article class="repercusion-card reveal card-fx shine-border panel-glass" data-reveal-delay="60ms">
      <div class="flex items-center gap-2 px-3 pt-3 sm:px-4 sm:pt-4">
        <span class="badge-glow badge-glow--amber repercusion-card__badge" style="margin:0;">Testimonio de dirección</span>
        <span class="repercusion-status-badge" role="status" aria-label="Próximamente">
          <span class="repercusion-status-badge__dot" aria-hidden="true"></span>
          Próximamente
        </span>
      </div>
      <div class="repercusion-card__media repercusion-card__media--placeholder" aria-hidden="true">
        <div class="repercusion-placeholder">
          <span class="repercusion-placeholder__icon-wrap">
            <svg class="repercusion-placeholder__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14V10z"></path>
              <rect x="3" y="6" width="12" height="12" rx="2"></rect>
            </svg>
          </span>
          <p class="repercusion-placeholder__label">Aquí irá el vídeo del director/a</p>
        </div>
      </div>
      <div class="repercusion-card__body">
        <h3 class="repercusion-card__title">Testimonio de dirección</h3>
        <p class="repercusion-card__text">
          Aquí se incorporará la declaración real de un miembro del equipo directivo sobre la implantación de
          Kids&Clouds, el impacto en la comunicación con las familias y la mejora de la organización del centro.
        </p>
        <div class="repercusion-card__profile">
          <p class="repercusion-profile-row">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
            Nombre Apellido
          </p>
          <p class="repercusion-profile-row">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="7" width="20" height="14" rx="2"></rect><path d="M16 7V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v2"></path></svg>
            Cargo
          </p>
          <p class="repercusion-profile-row">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 21h18"></path><path d="M5 21V7l8-4v18"></path><path d="M19 21V11l-6-4"></path><path d="M9 9v.01"></path><path d="M9 12v.01"></path><path d="M9 15v.01"></path><path d="M9 18v.01"></path></svg>
            Centro educativo
          </p>
          <p class="repercusion-profile-row">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
            Provincia
          </p>
        </div>
      </div>
    </article>

    <!-- Testimonio docente (placeholder) -->
    <article class="repercusion-card reveal-right card-fx shine-border panel-glass" data-reveal-delay="120ms">
      <div class="flex items-center gap-2 px-3 pt-3 sm:px-4 sm:pt-4">
        <span class="badge-glow badge-glow--amber repercusion-card__badge" style="margin:0;">Testimonio docente</span>
        <span class="repercusion-status-badge" role="status" aria-label="Próximamente">
          <span class="repercusion-status-badge__dot" aria-hidden="true"></span>
          Próximamente
        </span>
      </div>
      <div class="repercusion-card__media repercusion-card__media--placeholder" aria-hidden="true">
        <div class="repercusion-placeholder">
          <span class="repercusion-placeholder__icon-wrap">
            <svg class="repercusion-placeholder__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="2"></rect>
              <circle cx="8.5" cy="8.5" r="1.5"></circle>
              <path d="M21 15l-5-5L5 21"></path>
            </svg>
          </span>
          <p class="repercusion-placeholder__label">Aquí irá la foto del profesor/a</p>
        </div>
      </div>
      <div class="repercusion-card__body">
        <h3 class="repercusion-card__title">Testimonio docente</h3>
        <p class="repercusion-card__text">
          Aquí se incorporará la declaración real de un/a docente sobre cómo Kids&Clouds ayuda en el día a día del
          aula, facilita la comunicación con las familias y acompaña mejor la evolución del alumnado.
        </p>
        <div class="repercusion-card__profile">
          <p class="repercusion-profile-row">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
            Nombre Apellido
          </p>
          <p class="repercusion-profile-row">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="7" width="20" height="14" rx="2"></rect><path d="M16 7V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v2"></path></svg>
            Cargo
          </p>
          <p class="repercusion-profile-row">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 21h18"></path><path d="M5 21V7l8-4v18"></path><path d="M19 21V11l-6-4"></path><path d="M9 9v.01"></path><path d="M9 12v.01"></path><path d="M9 15v.01"></path><path d="M9 18v.01"></path></svg>
            Centro educativo
          </p>
          <p class="repercusion-profile-row">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
            Provincia
          </p>
        </div>
      </div>
    </article>
  </div>
</section>

<style>
  .repercusion-status-badge {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0;
    padding: 0.25rem 0.625rem;
    border-radius: 9999px;
    border: 1px solid rgba(220, 38, 38, 0.28);
    background: rgba(254, 242, 242, 0.95);
    color: #991b1b;
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1rem;
    letter-spacing: normal;
    text-transform: none;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
  }

  html.dark .repercusion-status-badge {
    border-color: rgba(248, 113, 113, 0.35);
    background: rgba(127, 29, 29, 0.35);
    color: #fecaca;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
  }

  .repercusion-status-badge__dot {
    width: 7px;
    height: 7px;
    flex-shrink: 0;
    border-radius: 50%;
    background: #dc2626;
    box-shadow: 0 0 0 0 rgba(220, 38, 38, 0.55);
    animation: repercusion-status-pulse 2s ease-in-out infinite;
  }

  html.dark .repercusion-status-badge__dot {
    background: #f87171;
    box-shadow: 0 0 0 0 rgba(248, 113, 113, 0.55);
  }

  @keyframes repercusion-status-pulse {
    0%,
    100% {
      box-shadow: 0 0 0 0 rgba(220, 38, 38, 0.45);
    }
    50% {
      box-shadow: 0 0 0 5px rgba(220, 38, 38, 0);
    }
  }

  .repercusion-grid {
    align-items: stretch;
  }

  .repercusion-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
  }

  .repercusion-card__badge {
    margin: 0.75rem 0.75rem 0;
    flex-shrink: 0;
    align-self: flex-start;
  }

  @media (min-width: 640px) {
    .repercusion-card__badge {
      margin: 1rem 1rem 0;
    }
  }

  /* Misma altura de zona media en las 4 columnas */
  .repercusion-card__media {
    flex-shrink: 0;
    height: 6rem;
    margin: 0.5rem 0.75rem 0;
    overflow: hidden;
    border-radius: 0.75rem;
  }

  @media (min-width: 640px) {
    .repercusion-card__media {
      height: 7rem;
      margin: 0.5rem 1rem 0;
    }
  }

  .repercusion-card__media--full-image {
    height: auto;
    overflow: visible;
    background: rgba(248, 250, 252, 0.6);
    border: 1px solid rgba(148, 163, 184, 0.15);
  }

  html.dark .repercusion-card__media--full-image {
    background: rgba(15, 23, 42, 0.45);
    border-color: rgba(148, 163, 184, 0.12);
  }

  .repercusion-card__media--full-image .repercusion-visual__img {
    width: 100%;
    height: auto;
    max-height: none;
    object-fit: contain;
  }

  .repercusion-card__media--placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    height: auto;
    min-height: 7.5rem;
    padding: 1.25rem 1rem;
    overflow: visible;
    background: rgba(241, 245, 249, 0.85);
    border: 1px solid rgba(148, 163, 184, 0.22);
  }

  html.dark .repercusion-card__media--placeholder {
    background: rgba(30, 41, 59, 0.55);
    border-color: rgba(148, 163, 184, 0.15);
  }

  @media (min-width: 640px) {
    .repercusion-card__media--placeholder {
      min-height: 8.5rem;
      padding: 1.5rem 1.25rem;
    }
  }

  .repercusion-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    text-align: center;
  }

  .repercusion-placeholder__icon-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.25rem;
    height: 3.25rem;
    border: 2px dashed rgba(148, 163, 184, 0.55);
    border-radius: 9999px;
    color: rgb(100 116 139);
  }

  html.dark .repercusion-placeholder__icon-wrap {
    border-color: rgba(148, 163, 184, 0.35);
    color: rgb(148 163 184);
  }

  .repercusion-placeholder__icon {
    width: 1.35rem;
    height: 1.35rem;
  }

  .repercusion-placeholder__label {
    max-width: 14rem;
    font-size: 0.8125rem;
    line-height: 1.4;
    color: rgb(100 116 139);
  }

  html.dark .repercusion-placeholder__label {
    color: rgb(148 163 184);
  }

  .repercusion-card__profile {
    margin-top: auto;
    padding: 0.75rem;
    border-radius: 0.75rem;
    background: rgba(241, 245, 249, 0.9);
    border: 1px solid rgba(148, 163, 184, 0.18);
  }

  @media (max-width: 639px) {
    .repercusion-card:has(.repercusion-card__media--placeholder) .repercusion-card__text {
      flex: 0 1 auto;
    }

    .repercusion-card:has(.repercusion-card__media--placeholder) .repercusion-card__profile {
      margin-top: 1.25rem;
    }
  }

  html.dark .repercusion-card__profile {
    background: rgba(30, 41, 59, 0.5);
    border-color: rgba(148, 163, 184, 0.12);
  }

  .repercusion-profile-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.35;
    color: rgb(100 116 139);
  }

  .repercusion-profile-row + .repercusion-profile-row {
    margin-top: 0.45rem;
  }

  .repercusion-profile-row svg {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
    color: rgb(148 163 184);
  }

  html.dark .repercusion-profile-row {
    color: rgb(148 163 184);
  }

  html.dark .repercusion-profile-row svg {
    color: rgb(100 116 139);
  }

  .repercusion-card__media--quote {
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(145deg, rgba(99, 102, 241, 0.12), rgba(240, 181, 82, 0.08));
    border: 1px solid rgba(148, 163, 184, 0.2);
  }

  html.dark .repercusion-card__media--quote {
    background: linear-gradient(145deg, rgba(99, 102, 241, 0.18), rgba(240, 181, 82, 0.1));
    border-color: rgba(148, 163, 184, 0.15);
  }

  .repercusion-card__quote-mark {
    font-size: 3rem;
    line-height: 1;
    font-weight: 700;
    color: rgba(99, 102, 241, 0.45);
  }

  html.dark .repercusion-card__quote-mark {
    color: rgba(129, 140, 248, 0.55);
  }

  .repercusion-card__body {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    min-height: 0;
    padding: 0.5rem 0.75rem 0.75rem;
  }

  @media (min-width: 640px) {
    .repercusion-card__body {
      padding: 0.5rem 1rem 0.75rem;
    }
  }

  .repercusion-card__title {
    font-size: 0.8125rem;
    font-weight: 700;
    line-height: 1.3;
    color: inherit;
  }

  @media (min-width: 640px) {
    .repercusion-card__title {
      font-size: 0.875rem;
    }
  }

  .repercusion-card__text {
    flex: 1 1 auto;
    margin-top: 0.4rem;
    font-size: 0.9rem;
    line-height: 1.6;
    color: rgb(71 85 105);
  }

  .repercusion-card__text--justify {
    text-align: justify;
    text-justify: inter-word;
  }

  .repercusion-card__footer--spacer {
    min-height: 3.5rem;
    margin-top: auto;
    padding-top: 0;
    border-top: none;
    visibility: hidden;
  }

  html.dark .repercusion-card__text {
    color: rgb(203 213 225);
  }

  .repercusion-card__hint {
    margin-top: 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: rgb(100 116 139);
  }

  html.dark .repercusion-card__hint {
    color: rgb(148 163 184);
  }

  .repercusion-card__footer {
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid rgba(226, 232, 240, 1);
  }

  html.dark .repercusion-card__footer {
    border-top-color: rgba(51, 65, 85, 0.8);
  }

  .repercusion-card__name {
    font-size: 0.9375rem;
    font-weight: 700;
    color: rgb(15 23 42);
  }

  html.dark .repercusion-card__name {
    color: #fff;
  }

  .repercusion-card__role {
    margin-top: 0.15rem;
    font-size: 0.8125rem;
    color: rgb(100 116 139);
  }

  @media (min-width: 640px) {
    .repercusion-card__role {
      font-size: 0.875rem;
    }
  }

  html.dark .repercusion-card__role {
    color: rgb(148 163 184);
  }


  .repercusion-visual {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    width: 100%;
    margin: 0;
    padding: 0;
    border: none;
    background: transparent;
    box-shadow: none;
    overflow: hidden;
    border-radius: 0.75rem;
  }

  .repercusion-visual::before,
  .repercusion-visual::after {
    display: none;
  }

  .repercusion-visual__img {
    display: block;
    width: 100%;
    height: 100%;
    max-height: 100%;
    object-fit: contain;
    object-position: center center;
    transition: opacity 0.3s ease;
  }

  /* Cambio de imagen según modo claro/oscuro */
  .theme-img--dark {
    display: none;
  }

  html.dark .theme-img--light {
    display: none;
  }

  html.dark .theme-img--dark {
    display: block;
  }

  .repercusion-visual:hover .repercusion-visual__img {
    opacity: 0.88;
  }

  .repercusion-zoom-hint {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(15, 23, 42, 0.42);
    opacity: 0;
    transition: opacity 0.25s ease;
    pointer-events: none;
  }

  .repercusion-zoom-hint svg {
    width: 2.25rem;
    height: 2.25rem;
    padding: 0.55rem;
    border-radius: 9999px;
    color: #0f172a;
    background: rgba(255, 255, 255, 0.95);
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.28);
  }

  html.dark .repercusion-zoom-hint {
    background: rgba(0, 0, 0, 0.48);
  }

  html.dark .repercusion-zoom-hint svg {
    color: #f0b552;
    background: rgba(15, 23, 42, 0.92);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
  }

  .repercusion-visual:hover .repercusion-zoom-hint,
  .repercusion-visual:focus-visible .repercusion-zoom-hint {
    opacity: 1;
  }

  @media (min-width: 1280px) {
    .repercusion-card {
      min-height: 20.5rem;
    }
  }
</style>
