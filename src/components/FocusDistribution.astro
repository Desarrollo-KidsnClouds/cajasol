---
interface Props {
  embedded?: boolean;
}

const { embedded = false } = Astro.props;
const Tag = embedded ? "div" : "section";
const outerClass = embedded
  ? "flex h-full min-w-0 flex-col"
  : "mx-auto w-full max-w-6xl px-5";
const innerGridClass = embedded
  ? "grid grid-cols-1 items-center gap-4"
  : "grid items-center gap-5 md:grid-cols-2";
const chartSizeClass = embedded
  ? "h-36 w-36 sm:h-40 sm:w-40"
  : "h-48 w-48 sm:h-52 sm:w-52";
---

<Tag class={outerClass} aria-label="Distribución de foco operativo del proyecto">
  <header class="reveal mb-3">
    <p class="section-eyebrow section-eyebrow--indigo">Distribución de foco</p>
    <h2 class:list={["section-title mt-2", embedded && "text-lg sm:text-xl"]}>
      Cómo se reparte el esfuerzo operativo del despliegue
    </h2>
  </header>

  <div class:list={["reveal card-fx shine-border panel-glass p-4", embedded && "flex-1", innerGridClass]}>
    <div class="flex flex-col items-center justify-center">
      <div
        class:list={["group relative transition duration-500 hover:scale-105", chartSizeClass]}
        role="img"
        aria-label="50 por ciento captación comercial, 30 por ciento presentaciones y 20 por ciento implantación"
      >
        <div
          class="h-full w-full rounded-full transition duration-500 group-hover:shadow-[0_0_40px_rgba(59,130,246,0.25)]"
          style="background: conic-gradient(#f59e0b 0 50%, #3b82f6 50% 80%, #10b981 80% 100%);"
        >
        </div>
        <div class="absolute inset-[18%] rounded-full bg-[#030712] ring-1 ring-slate-700/80 transition duration-500 group-hover:ring-indigo-500/50"></div>
        <div class="pointer-events-none absolute inset-0 animate-spin-slow rounded-full border border-dashed border-slate-700/40 opacity-40"></div>
      </div>
      <p class="mt-4 text-center text-sm font-medium text-slate-400">Reparto anual del esfuerzo operativo</p>
    </div>

    <ul class="space-y-3 text-sm">
      <li class="card-fx flex items-center justify-between rounded-xl border border-slate-200 bg-slate-50/90 px-4 py-3 hover:!border-amber-500/40 dark:border-slate-800/80 dark:bg-slate-950/60">
        <span class="inline-flex items-center gap-3 text-slate-300">
          <span class="h-3 w-3 shrink-0 rounded-sm bg-amber-400 shadow-[0_0_8px_rgba(251,191,36,0.6)]"></span>
          Captación comercial
        </span>
        <strong class="text-lg text-white">50%</strong>
      </li>
      <li class="card-fx flex items-center justify-between rounded-xl border border-slate-200 bg-slate-50/90 px-4 py-3 hover:!border-blue-500/40 dark:border-slate-800/80 dark:bg-slate-950/60">
        <span class="inline-flex items-center gap-3 text-slate-300">
          <span class="h-3 w-3 shrink-0 rounded-sm bg-blue-500 shadow-[0_0_8px_rgba(59,130,246,0.6)]"></span>
          Presentaciones y demos
        </span>
        <strong class="text-lg text-white">30%</strong>
      </li>
      <li class="card-fx flex items-center justify-between rounded-xl border border-slate-200 bg-slate-50/90 px-4 py-3 hover:!border-emerald-500/40 dark:border-slate-800/80 dark:bg-slate-950/60">
        <span class="inline-flex items-center gap-3 text-slate-300">
          <span class="h-3 w-3 shrink-0 rounded-sm bg-emerald-400 shadow-[0_0_8px_rgba(52,211,153,0.6)]"></span>
          Implantación y seguimiento
        </span>
        <strong class="text-lg text-white">20%</strong>
      </li>
    </ul>
  </div>
</Tag>
